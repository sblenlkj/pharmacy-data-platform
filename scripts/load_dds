#!/usr/bin/env python3
"""Load saved raw windows into processed source state, then affected DDS rows.

No PostgreSQL business reads. Typed staging views read stg_source_state.
The state MERGE ignores older/equal offsets; late replay cannot undo privacy
or history updates. Immutable batch bounds are saved before the dbt run.
"""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
import sys
import time
import uuid
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
DWH_DIR = REPO / "dwh"
DDL_PATH = DWH_DIR / "ddl" / "00_raw_ctl.sql"
DBT_TARGET_PATH = "/tmp/dwh-dbt-target"
DBT_LOG_PATH = "/tmp/dwh-dbt-logs"

# Таблицы dwh_detailed для сводки «вставлено строк по таблицам» (журнал).
DDS_TABLES = (
    "dim_sku", "dim_sku_version", "dim_price", "dim_customer", "dim_pharmacy",
    "dim_batch", "dim_supplier", "dim_distribution_center",
    "fact_sale_line", "fact_purchase_line", "fact_movement",
)

TRINO = {
    "host": os.environ.get("TRINO_HOST", "trino"),
    "port": int(os.environ.get("TRINO_PORT", "8080")),
    "user": os.environ.get("TRINO_USER", "admin"),
    "catalog": os.environ.get("TRINO_CATALOG", "iceberg"),
}


def log(message):
    print(f"load_dds: {message}", flush=True)


def trino_connect(attempts=6, wait=5.0):
    import trino.dbapi

    last = None
    for _ in range(attempts):
        try:
            conn = trino.dbapi.connect(
                host=TRINO["host"], port=TRINO["port"], user=TRINO["user"],
                catalog=TRINO["catalog"], timezone="UTC")
            cur = conn.cursor()
            cur.execute("SELECT 1")
            cur.fetchall()
            return conn
        except Exception as exc:  # noqa: BLE001 — произвольный сбой клиента/координатора
            last = exc
            time.sleep(wait)
    raise SystemExit(f"load_dds: trino недоступен ({TRINO['host']}): {last}")


def query(conn, sql, params=None):
    cur = conn.cursor()
    cur.execute(sql, params)
    names = [c[0].lower() for c in cur.description] if cur.description else []
    return [dict(zip(names, row)) for row in cur.fetchall()]


def execute(conn, sql, params=None):
    cur = conn.cursor()
    cur.execute(sql, params)
    cur.fetchall()


def apply_ctl_ddl(conn):
    """DDL инфраструктурного слоя (идемпотентен, IF NOT EXISTS) — единый
    источник dwh/ddl/00_raw_ctl.sql; ingest применяет его раньше, но образ
    ingest может быть старее последних таблиц ctl."""
    lines = [ln for ln in DDL_PATH.read_text(encoding="utf-8").splitlines()
             if not ln.lstrip().startswith("--")]
    statements = [s.strip() for s in "\n".join(lines).split(";") if s.strip()]
    for stmt in statements:
        execute(conn, stmt)
    log(f"ctl DDL applied: {len(statements)} statements (idempotent)")


def read_positions(conn):
    rows = query(conn, f"SELECT topic, partition_id, next_offset FROM {TRINO['catalog']}.ctl.kafka_positions")
    return {(r["topic"], r["partition_id"]): r["next_offset"] for r in rows}


def read_raw_maxima(conn):
    rows = query(
        conn,
        f"SELECT topic, partition_id, max(kafka_offset) + 1 AS end_offset "
        f"FROM {TRINO['catalog']}.raw.cdc_events GROUP BY topic, partition_id")
    return {(r["topic"], r["partition_id"]): r["end_offset"] for r in rows}


def compute_ranges(conn):
    """Диапазоны [saved_position, current_max) по каждому topic/partition."""
    positions = read_positions(conn)
    maxima = read_raw_maxima(conn)
    ranges = []
    for key in sorted(set(positions) | set(maxima)):
        start = positions.get(key, 0)
        end = maxima.get(key, 0)
        ranges.append({
            "topic": key[0], "partition": key[1],
            "start_offset": start, "end_offset": end,
        })
    return ranges


def read_batch(conn, batch_id):
    rows = query(conn, f"SELECT offsets_json, status FROM {TRINO['catalog']}.ctl.load_batches "
                       "WHERE batch_id = ?", (batch_id,))
    return rows[0] if rows else None


def has_successful_batch(conn):
    rows = query(conn, f"SELECT count(*) AS n FROM {TRINO['catalog']}.ctl.load_batches "
                       "WHERE status = 'success'")
    return rows[0]["n"] > 0


def batch_row_exists(conn, batch_id):
    return read_batch(conn, batch_id) is not None


def insert_batch_row(conn, batch_id, ranges, status):
    execute(conn, f"INSERT INTO {TRINO['catalog']}.ctl.load_batches VALUES (?, ?, ?)",
            (batch_id, offsets_json(ranges), status))


def offsets_json(ranges):
    return json.dumps(ranges, ensure_ascii=False, separators=(",", ":"))


def advance_positions(conn, ranges):
    """Один атомарный MERGE вместо N пар DELETE+INSERT: нет окна сбоя между
    ними и один снапшот ctl.kafka_positions на порцию."""
    active = [r for r in ranges if r["end_offset"] > r["start_offset"]]
    if not active:
        return
    values = ",".join(["(?, ?, ?)"] * len(active))
    execute(conn,
            f"MERGE INTO {TRINO['catalog']}.ctl.kafka_positions t "
            f"USING (VALUES {values}) AS s(topic, partition_id, next_offset) "
            "ON t.topic = s.topic AND t.partition_id = s.partition_id "
            "WHEN MATCHED THEN UPDATE SET next_offset = greatest(t.next_offset, s.next_offset) "
            "WHEN NOT MATCHED THEN INSERT VALUES (s.topic, s.partition_id, s.next_offset)",
            [v for r in active for v in (r["topic"], r["partition"], r["end_offset"])])


def staging_models(topics):
    """Затронутые топики → staging-модели: 'crm.public.customer' → stg_crm_customer."""
    models = set()
    for topic in topics:
        service, _, table = topic.split(".", 2)
        models.add(f"stg_{service}_{table.split('.')[-1]}")
    return sorted(models)


def run_dbt(batch_id, ranges, models, full_refresh):
    """dbt run in-process (dbt-trino в образе tools). Возвращает (ok, nodes):
    nodes — [{name, status, message}] для сводки/журнала."""
    from dbt.cli.main import dbtRunner

    # Initial run creates all dependent models; subsequent runs refresh state
    # first and select affected typed routes plus their DDS descendants.
    selection = " ".join(
        ["stg_source_state+"]
        if full_refresh else ["stg_source_state"] + [f"{m}+" for m in models])
    selection += " stg_cdc_events v_load_batches v_cdc_events"
    args = [
        "run",
        "--project-dir", str(DWH_DIR),
        "--profiles-dir", str(DWH_DIR),
        "--target-path", DBT_TARGET_PATH,
        "--log-path", DBT_LOG_PATH,
        "--no-use-colors",
        "--select", selection,
        "--vars", json.dumps({
            "load_batch_id": batch_id,
            "batch_ranges": ranges,
        }, ensure_ascii=False),
    ]
    if full_refresh:
        args.append("--full-refresh")
    log(f"dbt run --select '{selection}'{' --full-refresh' if full_refresh else ''} "
        f"(batch_id={batch_id}, {len(ranges)} диапазонов)")
    result = dbtRunner().invoke(args)
    nodes = []
    # dbt 1.12: dbtRunnerResult.result — результат задачи (RunResult),
    # внутри .results — список поузловых исходов; при сбое парсинга поле
    # может отсутствовать — тогда довольствуемся общим success.
    task_result = getattr(result, "result", None)
    for item in getattr(task_result, "results", None) or []:
        nodes.append({
            "name": item.node.name,
            "status": str(item.status),
            "message": (item.message or "").splitlines()[-1] if item.message else "",
        })
    return bool(result.success), nodes


def inserted_by_batch(conn, batch_id):
    """Строки, впервые записанные порцией (_load_batch_id при merge
    не перезаписывается) — для журнала загрузки. Один UNION ALL вместо
    11 последовательных count-сканов."""
    union = " UNION ALL ".join(
        f"SELECT '{table}' AS tbl, count(*) AS n "
        f"FROM {TRINO['catalog']}.dwh_detailed.{table} WHERE _load_batch_id = ?"
        for table in DDS_TABLES)
    return {row["tbl"]: row["n"] for row in query(conn, union, [batch_id] * len(DDS_TABLES))}


@contextmanager
def loader_lock():
    """All tools containers share /reports. Fail fast instead of racing MERGEs."""
    default = (Path("/reports") if Path("/reports").is_dir() else REPO / "reports") / ".hw02-load.lock"
    path = Path(os.environ.get("HW02_LOAD_LOCK", default))
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ValueError("другая загрузка уже выполняется; повторите после её завершения") from exc
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def set_batch_status(conn, batch_id, status):
    execute(conn, f"UPDATE {TRINO['catalog']}.ctl.load_batches "
                  "SET status = ? WHERE batch_id = ?", (status, batch_id))


def prepare_batch(conn, batch_id, replay):
    """Freeze bounds BEFORE any DDS writes; retry always uses these bounds."""
    stored = read_batch(conn, batch_id)
    pending = query(conn, f"SELECT batch_id FROM {TRINO['catalog']}.ctl.load_batches "
                         "WHERE status <> 'success'")
    other = [r["batch_id"] for r in pending if r["batch_id"] != batch_id]
    if other:
        raise ValueError(f"сначала восстановите незавершённую порцию: {other}")
    if replay and stored is None:
        raise ValueError(f"порция {batch_id} не найдена")
    if stored is not None:
        if stored["status"] == "success" and not replay:
            raise ValueError(f"batch_id {batch_id} уже использован; передайте --replay")
        ranges = json.loads(stored["offsets_json"])
    else:
        ranges = [r for r in compute_ranges(conn)
                  if r["end_offset"] > r["start_offset"]]
    # One partition per topic is an explicit property of this teaching stack.
    # Comparing offsets across partitions cannot define source-key ordering.
    if any(r["partition"] != 0 for r in ranges):
        raise ValueError("поддерживается одна Kafka-партиция (0) на топик; "
                         "смена числа партиций требует отдельного bootstrap")
    if stored is None and ranges:
        insert_batch_row(conn, batch_id, ranges, "running")
    elif stored is not None and stored["status"] != "success":
        set_batch_status(conn, batch_id, "running")
    return ranges, stored, not has_successful_batch(conn)


def validate_events(conn, ranges):
    # Soft delete is UPDATE. Never acknowledge unsupported physical DELETEs
    # or malformed keys as if they had been applied to DDS.
    if not ranges:
        return
    conditions, params = [], []
    for r in ranges:
        conditions.append("(topic = ? AND partition_id = ? "
                          "AND kafka_offset >= ? AND kafka_offset < ?)")
        params.extend([r["topic"], r["partition"], r["start_offset"], r["end_offset"]])
    invalid = query(conn,
        f"SELECT topic, kafka_offset, op FROM {TRINO['catalog']}.raw.cdc_events "
        "WHERE (" + " OR ".join(conditions) + ") AND "
        "(event_key IS NULL OR event_key = 'null' OR op NOT IN ('r','c','u')) LIMIT 1",
        params)
    if invalid:
        raise ValueError(f"неподдерживаемое событие (позиция не продвигается): {invalid}")


def load_batch(conn, batch_id, replay):
    ranges, stored, full_refresh = prepare_batch(conn, batch_id, replay)
    if not ranges and stored is None:
        log("новых событий нет — нечего грузить")
        return
    # Successful replay keeps both batch status and watermarks unchanged.
    committed_replay = replay and stored is not None and stored["status"] == "success"
    active_topics = {r["topic"] for r in ranges}
    models = staging_models(active_topics)
    log(f"{'replay' if replay else 'порция'} {batch_id}: "
        f"{len(ranges)} диапазонов; границы={offsets_json(ranges)}")
    try:
        validate_events(conn, ranges)
        ok, nodes = run_dbt(batch_id, ranges, models, full_refresh)
        expected = set(models) | {"stg_source_state"}
        executed = {n["name"] for n in nodes if n["status"] == "success"}
        if not ok or not expected.issubset(executed):
            failed = [n for n in nodes if n["status"] not in ("success", "skipped")]
            raise ValueError(f"dbt failed: {failed}; "
                             f"не выполнены модели: {sorted(expected - executed)}")
        inserted = inserted_by_batch(conn, batch_id)
        if full_refresh and ranges and sum(inserted.values()) == 0:
            raise ValueError("первая непустая порция записала 0 строк DDS")
        if not committed_replay:
            # These are separate Iceberg commits. A crash between them leaves
            # a pending batch; repeating its immutable bounds safely repairs it.
            advance_positions(conn, ranges)
            set_batch_status(conn, batch_id, "success")
        log(f"порция {batch_id} success; "
            f"строк, впервые записанных этой порцией: {sum(inserted.values())}; "
            f"позиции {'не изменены' if committed_replay else 'сохранены'}")
        for table, count in inserted.items():
            if count:
                log(f"  {table}: {count}")
    except Exception:
        if not committed_replay:
            set_batch_status(conn, batch_id, "failed")
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--batch-id")
    parser.add_argument("--replay", action="store_true")
    args = parser.parse_args()
    if args.replay and not args.batch_id:
        parser.error("--replay требует --batch-id")
    started = time.monotonic()
    batch_id = args.batch_id or str(uuid.uuid4())
    conn = None
    try:
        with loader_lock():
            conn = trino_connect()
            apply_ctl_ddl(conn)
            load_batch(conn, batch_id, args.replay)
        log(f"готово за {time.monotonic() - started:.1f} с ({batch_id})")
        return 0
    except Exception as exc:
        print(f"load_dds: {exc}", file=sys.stderr, flush=True)
        return 1
    finally:
        if conn is not None:
            conn.close()


if __name__ == "__main__":
    sys.exit(main())
