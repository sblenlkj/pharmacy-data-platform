# Optional: defaults work without copying this file. Local teaching credentials.
COMPOSE_PROJECT_NAME=pharmacy-hw1
POSTGRES_PASSWORD=postgres
REPLICATION_PASSWORD=replicator
APP_PASSWORD=app
CHECKER_PASSWORD=checker
PATRONI_API_PASSWORD=patroni
# HW2: deterministic namespace of the automatic base seed (db-init)
DATA_SEED=42
# HW2: password of the debezium CDC role (Debezium Connect reads the leader via haproxy:5000)
DEBEZIUM_PASSWORD=debezium
#
# Перечисленное выше — полный список переменных, которые docker-compose.yml
# подставляет из окружения (${VAR:-default}). Прочие настройки ДЗ-2 — литеральные
# константы в docker-compose.yml (намеренно, см. README «Переменные окружения»
# и ADR 010) и в .env НЕ настраиваются:
#   TRINO_HOST/PORT/USER/CATALOG, KAFKA_BOOTSTRAP, GROUP_ID, BATCH_ROWS,
#   FLUSH_SECONDS, INSERT_BUDGET (cdc-ingest), HW02_*_DSN (tools),
#   CONNECT_URL, CDC_SOURCES, CDC_*_TIMEOUT (cdc-init)
#   MINIO_ROOT_USER/MINIO_ROOT_PASSWORD/MINIO_DEFAULT_BUCKETS,
#   POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB (HMS), DB_DRIVER/SERVICE_NAME
# Когда меняете учётки выше, перегенерируйте submission-манифесты:
# docker compose run --rm -T --no-deps tools python scripts/infra/submission.py --output-dir /reports
# и скопируйте reports/hw01_submission*.yaml в корень репозитория.
